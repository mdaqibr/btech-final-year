        {
          "name": "Create Food Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Biriyani\",\n  \"description\": \"Spicy chicken biriyani\",\n  \"default_price\": 120\n}"
            },
            "url": "{{BASE_URL}}/api/food/"
          }
        },
        {
          "name": "Retrieve Food Item",
          "request": { "method": "GET", "url": "{{BASE_URL}}/api/food/:id/" }
